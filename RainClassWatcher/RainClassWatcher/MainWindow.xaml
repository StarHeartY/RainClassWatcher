<Window
    x:Class="RainClassWatcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RainClassWatcher"
    Title="RainClassWatcher">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Button
            Content="读取雨课堂 UI"
            Click="ReadRainClass_Click"/>

        <TextBox
            x:Name="OutputBox"
            Grid.Row="2"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>