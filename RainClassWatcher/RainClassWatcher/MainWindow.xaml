<Window
    x:Class="RainClassWatcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RainClassWatcher">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button
                x:Name="StartButton"
                Content="开始监控"
                Click="StartMonitoring_Click"/>

            <Button
                x:Name="StopButton"
                Content="停止监控"
                Click="StopMonitoring_Click"
                IsEnabled="False"/>

            <Button
                Content="单次检测"
                Click="ReadRainClass_Click"/>
        </StackPanel>

        <TextBox
            x:Name="OutputBox"
            Grid.Row="2"
            IsReadOnly="True"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            ScrollViewer.VerticalScrollBarVisibility="Auto"/>
    </Grid>
</Window>